NODE_ENV=development
PORT=3000

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database-name>?appName=Cluster0

JWT_ACCESS_SECRET=<change-me-access-secret>
JWT_REFRESH_SECRET=<change-me-refresh-secret>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

SUPABASE_URL=<https://your-project.supabase.co>
SUPABASE_SERVICE_ROLE_KEY=<change-me-supabase-service-role-key>
SUPABASE_BUCKET_NAME=<change-me-supabase-bucket-name>

# "brevo" sends real mail. "failing" is for demos: every send fails with 502
# EMAIL_UNAVAILABLE (UC04 E4, a share that can't be delivered; the password
# reset email fails too). Anything else (including unset) selects the no-op
# transport, which records the message and reports success without sending.
EMAIL_TRANSPORT=noop
EMAIL_FROM=<no-reply@your-domain.example>
BREVO_API_KEY=<change-me-brevo-api-key>

# No deep-link scheme is wired up yet, so this points at a placeholder base
# the reset screen is reached from by pasting the token.
PASSWORD_RESET_URL_BASE=<https://your-app.example/reset-password>

# UC03: minutes a rescue team lead has to acknowledge a dispatch before it is
# marked UNRESPONSIVE. Optional; defaults to 5.
DISPATCH_ACK_TIMEOUT_MINUTES=5

# UC01 demo: the share (0-1) of hazard-alert sends each mocked channel fails,
# to show the delivery failures and SMS fallback (E3). 0 or unset never fails.
DEMO_FAIL_PUSH_RATE=0
DEMO_FAIL_SMS_RATE=0
DEMO_FAIL_AUDIBLE_RATE=0
